<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- macOS-local-only: includes Safari, which cannot run in Linux CI. -->
<suite name="FullRegressionSuite-Full" parallel="tests" thread-count="5">
    <listeners>
        <listener class-name="com.qa.framework.listeners.TestListener"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="UI-Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.qa.framework.tests.ui.LoginTests"/>
            <class name="com.qa.framework.tests.ui.DashboardTests"/>
        </classes>
    </test>

    <test name="UI-Firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.qa.framework.tests.ui.LoginTests"/>
            <class name="com.qa.framework.tests.ui.DashboardTests"/>
        </classes>
    </test>

    <test name="UI-Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.qa.framework.tests.ui.LoginTests"/>
            <class name="com.qa.framework.tests.ui.DashboardTests"/>
        </classes>
    </test>

    <test name="UI-Safari">
        <parameter name="browser" value="safari"/>
        <classes>
            <class name="com.qa.framework.tests.ui.LoginTests"/>
            <class name="com.qa.framework.tests.ui.DashboardTests"/>
        </classes>
    </test>

    <test name="API-Suite">
        <classes>
            <class name="com.qa.framework.tests.api.UserApiTests"/>
            <class name="com.qa.framework.tests.api.RegisterApiTests"/>
        </classes>
    </test>

    <!-- Pure unit tests for the AI failure explainer -- no browser/grid/network required. -->
    <test name="AIAgent-Unit">
        <classes>
            <class name="com.qa.framework.aiagent.explainer.FailureCollectorTests"/>
            <class name="com.qa.framework.aiagent.explainer.FailureContextExtractorTests"/>
            <class name="com.qa.framework.aiagent.explainer.FailureExplanationReportTests"/>
        </classes>
    </test>
</suite>
