# Copy to .env (git-ignored) or export these directly in your shell. Never commit real values.

# Free key from https://app.reqres.in/api-keys
REQRES_API_KEY=

# Only needed if your Grid hub isn't at the local Docker Compose default.
GRID_HUB_URL=http://localhost:4444/wd/hub

# Only needed to run the AI failure explainer (see README). Get a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
